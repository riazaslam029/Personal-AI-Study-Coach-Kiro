# Root-level .env.example
# Copy relevant sections to backend/.env and frontend/.env

# =============================================================================
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# =============================================================================

# Database
DATABASE_URL=postgresql+asyncpg://user:password@host/database

# Authentication
JWT_SECRET_KEY=your-secret-key-minimum-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Service - Primary: Google Gemini
# Get an API key at https://aistudio.google.com/apikey (starts with "AIzaSy...")
# Leave blank to skip Gemini and use OpenRouter directly.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# AI Service - Primary: OpenRouter with 11-model cascade (fastest first)
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free
OPENROUTER_MODELS=nex-agi/nex-n2.5-mini:free,nvidia/nemotron-3-super-120b-a12b:free,nex-agi/nex-n2.5-pro:free,inclusionai/ling-3.0-flash-sante:free,poolside/laguna-s-2.1:free,inclusionai/ling-3.0-flash-fin:free,liquid/lfm-2.5-2.6b:free,cohere/north-mini-code:free,nvidia/nemotron-3.5-lightning:free,dots-studio/dots-3-note-preview:free,nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Personal AI Study Coach

# Which provider to try first: "openrouter" (recommended) or "gemini"
AI_PRIMARY_PROVIDER=openrouter

# Storage
# Options: local (dev) | supabase (prod) | s3 (prod, AWS)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads

# Supabase Storage (when STORAGE_BACKEND=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_BUCKET=study-materials

# AWS S3 (when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET=your-s3-bucket-name
S3_PRESIGNED_URL_TTL=3600

# CORS
ALLOWED_ORIGINS=["http://localhost:5173"]

# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# =============================================================================

VITE_API_URL=http://localhost:8000
