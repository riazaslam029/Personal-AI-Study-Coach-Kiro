# =============================================================================
# Study Coach Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit a real .env file — it is listed in .gitignore.
# =============================================================================

# Database — Neon PostgreSQL (asyncpg format)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# JWT Authentication
JWT_SECRET_KEY=replace-with-a-256-bit-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Provider Configuration
# Primary: Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Fallback: OpenRouter (used when Gemini rate limit is hit)
# Get your free API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Personal AI Study Coach

# File Storage
# Use "local" for development, "supabase" for production
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads

# Supabase Storage (required when STORAGE_BACKEND=supabase)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=study-materials

# CORS — JSON array of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:5173"]
